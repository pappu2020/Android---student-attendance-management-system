<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ========================================= -->
        <!-- HEADER -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dashboard_header_new"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvDashboardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Attendance"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Welcome"
                android:textColor="#E3F2FD"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Role: User"
                android:textColor="#BBDEFB"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- SECTION TITLE -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Dashboard"
            android:textColor="#212121"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Manage your attendance system"
            android:textColor="#757575"
            android:textSize="14sp" />


        <!-- ========================================= -->
        <!-- ADD STUDENT -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/btnStudents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dashboard_card_new"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="82dp"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="#E3F2FD"
                android:gravity="center"
                android:text="👨‍🎓"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Student"
                    android:textColor="#212121"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Add or update student information"
                    android:textColor="#757575"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#1976D2"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- STUDENT LIST -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/btnStudentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card_new"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="82dp"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="#E8F5E9"
                android:gravity="center"
                android:text="📋"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student List"
                    android:textColor="#212121"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="View students by class and section"
                    android:textColor="#757575"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#2E7D32"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- MARK ATTENDANCE -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/btnAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card_new"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="82dp"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="#FFF3E0"
                android:gravity="center"
                android:text="📝"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mark Attendance"
                    android:textColor="#212121"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Take daily student attendance"
                    android:textColor="#757575"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#EF6C00"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- ATTENDANCE HISTORY -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card_new"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="82dp"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="#F3E5F5"
                android:gravity="center"
                android:text="📊"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance History"
                    android:textColor="#212121"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Check previous attendance records"
                    android:textColor="#757575"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#8E24AA"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- ATTENDANCE REPORT -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/btnReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card_new"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="82dp"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="#E0F2F1"
                android:gravity="center"
                android:text="📈"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance Report"
                    android:textColor="#212121"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="View attendance statistics"
                    android:textColor="#757575"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#00897B"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- LOGOUT -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#D32F2F"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
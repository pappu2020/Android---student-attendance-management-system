<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================================================= -->
        <!-- Header -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_dashboard_header_new">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Management"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Add or update student information"
                android:textColor="#E3F2FD"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Student Form Card -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_student_filter">


            <!-- Student Name -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etStudentName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_spinner"
                android:hint="Enter student name"
                android:inputType="textPersonName"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp" />


            <!-- Roll Number -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Roll Number"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRollNumber"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_spinner"
                android:hint="Enter roll number"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp" />


            <!-- ================================================= -->
            <!-- Class -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Class"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerStudentClass"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_spinner"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />


            <!-- ================================================= -->
            <!-- Section -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Section"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerStudentSection"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_spinner"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />


            <!-- ================================================= -->
            <!-- Email -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Email"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etStudentEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_spinner"
                android:hint="Enter email address"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp" />


            <!-- ================================================= -->
            <!-- Phone -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Phone Number"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etStudentPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_spinner"
                android:hint="Enter phone number"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp" />


            <!-- ================================================= -->
            <!-- Photo Section -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Student Photo"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivStudentPhoto"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:contentDescription="Student Photo"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSelectPhoto"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="SELECT PHOTO"
                android:textAllCaps="false"
                android:textColor="#1565C0"
                android:textSize="15sp" />


            <!-- ================================================= -->
            <!-- Message -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text=""
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- Progress -->
            <!-- ================================================= -->

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- ADD / UPDATE BUTTON -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnAddStudent"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:text="ADD STUDENT"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- CANCEL EDIT -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnCancelEdit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="CANCEL EDIT"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:visibility="gone" />

        </LinearLayout>


        <!-- Bottom Space -->

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>

</ScrollView>
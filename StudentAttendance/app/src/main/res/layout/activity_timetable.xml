
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB"
    android:padding="16dp">

    <!-- Back to Dashboard -->
    <Button
        android:id="@+id/btnBackTimetable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back to Dashboard"
        android:textAllCaps="false" />

    <!-- Screen Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Class Timetable"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#172554"
        android:paddingBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select class, section and day"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:paddingBottom="12dp" />

    <!-- Class Spinner -->
    <Spinner
        android:id="@+id/spinnerClass"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="8dp" />

    <!-- Section Spinner -->
    <Spinner
        android:id="@+id/spinnerSection"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="8dp" />

    <!-- Day Spinner -->
    <Spinner
        android:id="@+id/spinnerDay"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="8dp" />

    <!-- Load Timetable -->
    <Button
        android:id="@+id/btnLoadTimetable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Load Timetable"
        android:textAllCaps="false" />

    <!-- Refresh Timetable -->
    <Button
        android:id="@+id/btnRefreshTimetable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Refresh Timetable"
        android:textAllCaps="false" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressTimetable"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- Status Message -->
    <TextView
        android:id="@+id/txtTimetableMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select a class, section and day."
        android:textColor="#475569"
        android:textSize="14sp" />

    <!-- Timetable Cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTimetable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
